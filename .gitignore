# dependencies
/node_modules
/.pnp
.pnp.*
.npm
.pnpm-store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# local tool binaries

# misc
.DS_Store
*.pem
.cache
.turbo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
